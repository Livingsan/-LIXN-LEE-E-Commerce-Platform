# =====================================================================
# LIXNLEE eCommerce - Environment Configuration Template
# =====================================================================
# Copy this file to .env and configure your production or staging values:
#   cp .env.example .env
#
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL!
# =====================================================================

# Database Configuration
# Local XAMPP default: 127.0.0.1, root, empty password, shop_db, 3306
# Production: Use a dedicated user with a strong password!
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shop_db
DB_USER=lixnlee_user
DB_PASSWORD=YourStrongSecurePasswordHere!

# Application Environment (development | production)
APP_ENV=development
